# ---- .env.news  (news-sentiment: Finnhub, SEC EDGAR, Reddit (optional)) ----
# Copy to .env.news (git-ignored) or run `trader init-env`, then fill in the values.
# How to get every value: docs/ACCOUNT_SETUP.md. Format: KEY=value, no quotes,
# no comments after a value. Never commit the real file (SEC-6, SEC-18).

# Finnhub (required): finnhub.io -> Get free API key
FINNHUB_TOKEN=
# SEC EDGAR (no account): your name and email; same text as data.sec_user_agent
SEC_USER_AGENT=agentic-ai-trading-system <your-name> <your-email>
# Reddit (optional): reddit.com/prefs/apps -> script app; leave empty to skip
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=agentic-ai-trading-system/0.1 by <your-reddit-username>
# Database URL for this container's role. `trader init-env` fills it from docker/.env and
# secrets/pg_news_password.txt. Host is always `postgres` (the Compose service).
DATABASE_URL=postgresql+psycopg://news_rw:<password>@postgres:5432/trader

# ---- .env.console  (owner console: local web app on http://localhost:8080, UI_REQUIREMENTS.md) ----
# Copy to .env.console (git-ignored) or run `./run.sh setup`. The login password is in
# secrets/console_password.txt. The console holds no broker keys: quotes and the checklist
# dry-run come from trader-core's internal API (no host port).
CORE_API_URL=http://trader-core:8081
OLLAMA_URL=http://ollama:11434
# Session idle timeout (minutes) for the web login (UI-21)
CONSOLE_IDLE_MIN=30
# Database URL for the console role (SELECT on the journal; may publish only owner commands).
# `trader init-env` fills it from docker/.env and secrets/pg_console_password.txt.
DATABASE_URL=postgresql+psycopg://console_rw:<password>@postgres:5432/trader

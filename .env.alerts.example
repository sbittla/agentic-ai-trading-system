# ---- .env.alerts  (alerts: standalone Telegram price alerts, docs/ALERTS.md) ----
# Copy to .env.alerts (git-ignored) or run `trader init-env`, then fill in the values.
# Format: KEY=value, no quotes, no comments after a value. Never commit the real file.

# Alpaca market data (paper keys are fine: the free IEX feed is the same for paper and live).
# Alpaca allows ONE market-data WebSocket per account: do not run trader-core on the same keys.
ALPACA_KEY=
ALPACA_SECRET=
# Telegram: @BotFather -> /newbot gives the token. Message your bot, then run
#   trader telegram-chats --env-file .env.alerts   to see your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chat ids allowed to send commands (comma-separated; default TELEGRAM_CHAT_ID)
TELEGRAM_ALLOWED_CHAT_IDS=

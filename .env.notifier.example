# ---- .env.notifier  (notifier: owner messages (Telegram default, ADR-014)) ----
# Copy to .env.notifier (git-ignored) or run `trader init-env`, then fill in the values.
# How to get every value: docs/ACCOUNT_SETUP.md. Format: KEY=value, no quotes,
# no comments after a value. Never commit the real file (SEC-6, SEC-18).

# Channel: telegram (default when TELEGRAM_BOT_TOKEN is set) or whatsapp
NOTIFIER_CHANNEL=telegram
# Telegram: @BotFather -> /newbot gives the token. Message your bot, then run
#   trader telegram-chats --env-file .env.notifier   to see your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SEC-1: chat ids allowed to send commands (comma-separated; default TELEGRAM_CHAT_ID)
TELEGRAM_ALLOWED_CHAT_IDS=
# WhatsApp via Twilio (only with NOTIFIER_CHANNEL=whatsapp; trial numbers send templates only)
TWILIO_SID=
TWILIO_TOKEN=
WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+1XXXXXXXXXX
WHATSAPP_ALLOWED_SENDERS=whatsapp:+1XXXXXXXXXX
# Own sender: approved template with one body variable {{1}}, used outside the 24 h window
WHATSAPP_CONTENT_SID=
WHATSAPP_CONTENT_VARIABLE=1
# Database URL for this container's role. `trader init-env` fills it from docker/.env and
# secrets/pg_notifier_password.txt. Host is always `postgres` (the Compose service).
DATABASE_URL=postgresql+psycopg://notifier_rw:<password>@postgres:5432/trader

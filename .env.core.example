# ---- .env.core  (trader-core: Alpaca PAPER account + core database role) ----
# Copy to .env.core (git-ignored) or run `trader init-env`, then fill in the values.
# How to get every value: docs/ACCOUNT_SETUP.md. Format: KEY=value, no quotes,
# no comments after a value. Never commit the real file (SEC-6, SEC-18).

# Alpaca PAPER keys: paper dashboard -> API keys (usually start with PK)
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
# Database URL for this container's role. `trader init-env` fills it from docker/.env and
# secrets/pg_core_password.txt. Host is always `postgres` (the Compose service).
DATABASE_URL=postgresql+psycopg://core_rw:<password>@postgres:5432/trader

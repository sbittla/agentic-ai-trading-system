# Compose variables. Copy to docker/.env (git-ignored) and adjust.
# Database name, admin user and the prefix of the four service roles
# (roles become <prefix>core_rw, <prefix>news_rw, <prefix>notifier_rw, <prefix>readonly).
# Changing these after the Postgres volume exists has no effect: init runs only once.
PG_DATABASE=trader
PG_ADMIN_USER=trader_admin
DB_ROLE_PREFIX=
# Model fetched by `--profile setup run --rm model-pull`; must match llm.model in config.yaml.
# `trader select-model` shows what fits your GPU; `--apply` sets both (docs/HARDWARE.md):
#   qwen3:4b (4-6 GB GPU) · qwen3:8b (8-11 GB) · qwen3:14b (12-16 GB) · qwen3:32b (24 GB+)
OLLAMA_MODEL=qwen3:8b

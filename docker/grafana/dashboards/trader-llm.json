{
  "uid": "trader-llm",
  "title": "4. LLM (Qwen)",
  "tags": [
    "trader"
  ],
  "timezone": "America/New_York",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Calls",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FROM journal.llm_calls WHERE $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Valid JSON first try",
      "description": "Alert below 95%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * avg(valid::int) AS valid FROM journal.llm_calls WHERE $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency p95",
      "description": "Amber above 20 s, red (entries blocked) above 45 s.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS p95 FROM journal.llm_calls WHERE $__timeFilter(ts) AND NOT cached"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20000
              },
              {
                "color": "red",
                "value": 45000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Skip / disagree rate",
      "description": "Below 10% suggests rubber-stamping; above 90% blocks everything.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE verdict = 'disagree') / NULLIF(count(*), 0) AS rate\nFROM journal.reviews WHERE $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 10
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tokens per call (avg)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(input_tokens + output_tokens) AS tokens FROM journal.llm_calls WHERE $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Errors",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FROM journal.llm_calls WHERE $__timeFilter(ts) AND error IS NOT NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p50 / p95 by agent",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1h'), agent || ' p50' AS metric,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) AS value\nFROM journal.llm_calls WHERE $__timeFilter(ts) AND NOT cached GROUP BY 1, 2\nUNION ALL\nSELECT $__timeGroupAlias(ts, '1h'), agent || ' p95',\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms)\nFROM journal.llm_calls WHERE $__timeFilter(ts) AND NOT cached GROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "table",
      "title": "By agent and prompt version",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT agent, prompt_version, model, count(*) AS calls,\n       round(100.0 * avg(valid::int), 1) AS valid_pct,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms)::int AS p50_ms,\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms)::int AS p95_ms,\n       avg(input_tokens)::int AS avg_in, avg(output_tokens)::int AS avg_out\nFROM journal.llm_calls WHERE $__timeFilter(ts) GROUP BY 1, 2, 3 ORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent calls",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts, agent, prompt_version, valid, latency_ms, input_tokens, output_tokens, cached,\n       error, left(output, 300) AS output\nFROM journal.llm_calls WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}

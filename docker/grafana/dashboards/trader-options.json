    {
      "id": 3,
      "type": "stat",
      "title": "Win rate",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * avg((pnl > 0)::int) AS win_rate FROM journal.option_suggestions WHERE $__timeFilter(ts) AND status = 'closed'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 35
              },
              {
                "color": "green",
                "value": 45
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [

    {
      "id": 4,
      "type": "stat",
      "title": "Expectancy (R)",
      "description": "R = max loss per contract. Promotion gate A16-4: >= +0.15R.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(r_multiple) AS expectancy FROM journal.option_suggestions WHERE $__timeFilter(ts) AND status = 'closed'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Profit factor",
      "description": "Promotion gate A16-4: >= 1.3.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(pnl) FILTER (WHERE pnl > 0) / NULLIF(-sum(pnl) FILTER (WHERE pnl < 0), 0) AS profit_factor FROM journal.option_suggestions WHERE $__timeFilter(ts) AND status = 'closed'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 1.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "View right, option lost",
      "description": "The structure, not the view, lost (A16-2).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE stock_view_right AND pnl <= 0) AS n FROM journal.option_suggestions WHERE $__timeFilter(ts) AND status = 'closed'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "By structure",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT structure AS \"structure\", count(*) AS graded, round(100.0 * avg((pnl > 0)::int), 0) AS win_pct,\n       round(avg(r_multiple)::numeric, 2) AS avg_r, round(sum(pnl), 2) AS pnl FROM journal.option_suggestions WHERE $__timeFilter(ts) AND status = 'closed'\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "table",
      "title": "By direction",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT direction AS \"direction\", count(*) AS graded, round(100.0 * avg((pnl > 0)::int), 0) AS win_pct,\n       round(avg(r_multiple)::numeric, 2) AS avg_r, round(sum(pnl), 2) AS pnl FROM journal.option_suggestions WHERE $__timeFilter(ts) AND status = 'closed'\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "table",
      "title": "By IV regime",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN iv_rank IS NULL THEN 'n/a' WHEN iv_rank < 30 THEN 'IV<30' WHEN iv_rank <= 60 THEN 'IV30-60' ELSE 'IV>60' END AS \"IV regime\", count(*) AS graded, round(100.0 * avg((pnl > 0)::int), 0) AS win_pct,\n       round(avg(r_multiple)::numeric, 2) AS avg_r, round(sum(pnl), 2) AS pnl FROM journal.option_suggestions WHERE $__timeFilter(ts) AND status = 'closed'\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "table",
      "title": "By DTE bucket",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN expiry - (ts AT TIME ZONE 'America/New_York')::date <= 7 THEN '0-7' WHEN expiry - (ts AT TIME ZONE 'America/New_York')::date <= 14 THEN '8-14' WHEN expiry - (ts AT TIME ZONE 'America/New_York')::date <= 30 THEN '15-30' ELSE '31+' END AS \"DTE bucket\", count(*) AS graded, round(100.0 * avg((pnl > 0)::int), 0) AS win_pct,\n       round(avg(r_multiple)::numeric, 2) AS avg_r, round(sum(pnl), 2) AS pnl FROM journal.option_suggestions WHERE $__timeFilter(ts) AND status = 'closed'\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "table",
      "title": "Promotion gate (A16-4: >= 40 graded, >= +0.15R, PF >= 1.3, >= 20 sessions)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT structure, direction, count(*) AS graded, round(avg(r_multiple)::numeric, 2) AS avg_r,\n       round((sum(pnl) FILTER (WHERE pnl > 0) / NULLIF(-sum(pnl) FILTER (WHERE pnl < 0), 0))\n             ::numeric, 2) AS pf,\n       count(DISTINCT (ts AT TIME ZONE 'America/New_York')::date) AS sessions\nFROM journal.option_suggestions WHERE status = 'closed'\nGROUP BY 1, 2 ORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "table",
      "title": "Suggestions",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts, ticker, direction, source, structure, expiry, contracts, entry_price, max_loss,\n       max_gain, iv_rank, status, mark AS pl_per_contract, pnl, round(r_multiple::numeric, 2) AS r,\n       exit_reason, stock_view_right\nFROM journal.option_suggestions WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}

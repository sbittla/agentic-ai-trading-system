    {
      "id": 6,
      "type": "stat",
      "title": "Current drawdown",
      "description": "-3% cuts size (RC-1); -6% in a month stops trading (LL-6).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100 * (equity - hwm) / NULLIF(hwm, 0) AS dd FROM journal.equity ORDER BY ts DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -6
              },
              {
                "color": "yellow",
                "value": -3
              },
              {
                "color": "green",
                "value": -0.0001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"

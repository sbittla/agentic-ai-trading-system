    {
      "id": 3,
      "type": "stat",
      "title": "Expectancy (R per trade)",
      "description": "Alert when below 0 over 20 trades (RC-3).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 8,
        "y": 0,

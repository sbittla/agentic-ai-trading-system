{
  "uid": "trader-ideas",
  "title": "6. Next-day ideas",
  "tags": [
    "trader"
  ],
  "timezone": "America/New_York",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"

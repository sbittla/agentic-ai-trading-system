  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ideas for",
      "description": "Built after the close (4:15 PM ET) or by `trader plan` / PLAN; the 9:00 and 2:45 plans refresh it with gap and pre-market data.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(max(plan_for), 'Dy Mon DD') AS session FROM journal.next_day_ideas WHERE run_at = (SELECT max(run_at) FROM journal.next_day_ideas WHERE plan_for = (SELECT max(plan_for) FROM journal.next_day_ideas))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/session/",
          "values": false
        }
      }
    },
    {

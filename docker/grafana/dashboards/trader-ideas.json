            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'pick') AS picks FROM journal.next_day_ideas WHERE run_at = (SELECT max(run_at) FROM journal.next_day_ideas WHERE plan_for = (SELECT max(plan_for) FROM journal.next_day_ideas))"
        }

    {
      "id": 9,
      "type": "table",
      "title": "Track record (graded on the planned session)",
      "description": "Daily bars cannot tell whether T1 or the stop came first: 'T1 and stop'.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 10,
        "y": 15,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT plan_for AS session, ticker,\n       coalesce(morning_setup, afternoon_setup) AS setup,\n       coalesce(morning_trigger, afternoon_trigger) AS trigger,\n       coalesce(morning_stop, afternoon_stop) AS stop,\n       coalesce(morning_target, afternoon_target) AS t1,\n       day_high, day_low, day_close, outcome\nFROM journal.next_day_ideas\nWHERE status = 'pick' AND outcome IS NOT NULL AND $__timeFilter(run_at)\nORDER BY plan_for DESC, rank"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "outcome"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "t1": {
                        "color": "green",
                        "index": 0,
                        "text": "reached T1"
                      },
                      "open": {
                        "color": "blue",
                        "index": 1,
                        "text": "triggered, open"
                      },
                      "both": {
                        "color": "orange",
                        "index": 2,
                        "text": "T1 and stop"
                      },
                      "stopped": {
                        "color": "red",
                        "index": 3,
                        "text": "stopped"
                      },
                      "not_triggered": {
                        "color": "text",
                        "index": 4,
                        "text": "not triggered"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {}
    }

    {
      "id": 7,
      "type": "table",
      "title": "Next-day ideas (latest run)",
      "description": "score: 30 uptrend + 20 strong close + 15 volume >= avg + 15 pullback to EMA + 20 has a candidate setup. ATR distances: negative = already above.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT rank AS \"#\", ticker, status, score, close, change_pct AS \"day %\",\n       range_pos AS \"close in range\", volume_ratio AS \"vol vs 50d\", trend_up AS uptrend,\n       atr_to_prior_high AS \"ATR to prior high\", atr_to_20d_closing_high AS \"ATR to 20d close high\",\n       morning_setup || ' ' || morning_trigger || ' / ' || morning_stop || ' / ' || morning_target\n         AS \"morning: trigger / stop / T1\",\n       afternoon_setup || ' ' || afternoon_trigger || ' / ' || afternoon_stop || ' / '\n         || afternoon_target AS \"afternoon: trigger / stop / T1\",\n       news_tone AS news, note\nFROM journal.next_day_ideas WHERE run_at = (SELECT max(run_at) FROM journal.next_day_ideas WHERE plan_for = (SELECT max(plan_for) FROM journal.next_day_ideas)) ORDER BY rank"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "pick": {
                        "color": "green",
                        "index": 0,
                        "text": "PICK"
                      },
                      "watch": {
                        "color": "blue",
                        "index": 1,
                        "text": "watch"
                      },
                      "skip": {
                        "color": "orange",
                        "index": 2,
                        "text": "passed (Qwen)"
                      },
                      "off": {
                        "color": "red",
                        "index": 3,
                        "text": "OFF-LIMITS"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "score"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 50
                    },
                    {
                      "color": "green",
                      "value": 70
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "day %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {}

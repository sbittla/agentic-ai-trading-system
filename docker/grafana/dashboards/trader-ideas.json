    {
      "id": 8,
      "type": "bargauge",
      "title": "Readiness score",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "journal"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "journal"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ticker, score FROM journal.next_day_ideas WHERE run_at = (SELECT max(run_at) FROM journal.next_day_ideas WHERE plan_for = (SELECT max(plan_for) FROM journal.next_day_ideas)) ORDER BY score DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {

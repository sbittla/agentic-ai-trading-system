# ---- .env.backup  (backup: nightly pg_dump with the read-only role) ----
# Copy to .env.backup (git-ignored) or run `trader init-env`, then fill in the values.
# How to get every value: docs/ACCOUNT_SETUP.md. Format: KEY=value, no quotes,
# no comments after a value. Never commit the real file (SEC-6, SEC-18).

# Database URL for this container's role. `trader init-env` fills it from docker/.env and
# secrets/pg_readonly_password.txt. Host is always `postgres` (the Compose service).
DATABASE_URL=postgresql+psycopg://readonly:<password>@postgres:5432/trader

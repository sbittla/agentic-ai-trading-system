# Each container reads only its own env file (docs/SECURITY.md SEC-18).
# Copy each block to the named file and fill it in. Never commit these files.

# ---- .env.core  (trader-core) ----
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
DATABASE_URL=postgresql+psycopg://core_rw:<password>@postgres:5432/trader

# ---- .env.live  (trader-core, go-live only, SEC-7) ----
# ALPACA_LIVE_KEY=
# ALPACA_LIVE_SECRET=

# ---- .env.news  (news-sentiment) ----
FINNHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AIAgentsTrading/0.1 by <your-reddit-username>
SEC_USER_AGENT=AIAgentsTrading <your-name> <your-email>
DATABASE_URL=postgresql+psycopg://news_rw:<password>@postgres:5432/trader

# ---- .env.notifier  (notifier) ----
TWILIO_SID=
TWILIO_TOKEN=
WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
WHATSAPP_TO=whatsapp:+1XXXXXXXXXX
WHATSAPP_ALLOWED_SENDERS=whatsapp:+1XXXXXXXXXX   # SEC-1, comma-separated
DATABASE_URL=postgresql+psycopg://notifier_rw:<password>@postgres:5432/trader

# ---- .env.backup  (backup) ----
DATABASE_URL=postgresql+psycopg://readonly:<password>@postgres:5432/trader

# ---- .env.replay  (replay, dev) ----
# No keys needed: replays use SimBroker and a per-run SQLite journal (BACKTEST_ENGINE.md).
REPLAY=1

# ---- secrets/pg_admin_password.txt ----
# Postgres admin password, one line, used only at database initialisation.
